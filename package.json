{
  "name": "opencode-studio-server",
  "version": "2.4.5",
  "private": false,
  "description": "OpenCode Studio (fork of Microck/opencode-studio, original author: Microck)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knippers/opencode-studio.git"
  },
  "homepage": "https://github.com/knippers/opencode-studio#readme",
  "bugs": {
    "url": "https://github.com/knippers/opencode-studio/issues"
  },
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm start",
    "client": "cd client-next && npm run dev",
    "build": "cd client-next && npm run build",
    "postinstall": "cd server && npm install && cd ../client-next && npm install",
    "release-server": "cd server && npm publish"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
